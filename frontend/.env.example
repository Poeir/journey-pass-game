# =============================================================================
# Journey Pass — Frontend env template
# Copy this file to `.env` and adjust per environment.
# Production values are injected by the company CI/CD pipeline at build time.
# =============================================================================

# Base URL for HTTP API requests.
# - Local dev: leave as `/api` — Vite proxy (vite.config.ts) forwards to the
#   backend on localhost:4000.
# - Deployed: set to the backend's public path. If the frontend and backend
#   share an origin via the company reverse proxy, `/api` is also valid.
#   Otherwise use the full URL, e.g. https://api.<company-domain>/api
VITE_API_BASE=/api

# Base URL for WebSocket connections (optional).
# When unset, derived from VITE_API_BASE.
# - Local dev: leave unset — Vite proxy (`ws: true`) handles upgrades.
# - Deployed: same-origin via reverse proxy → leave unset.
#   Cross-origin → wss://api.<company-domain>/api
# VITE_WS_BASE=

# Dev-only login bypass. Set to the literal string "true" to render the
# "log in as any employee" picker on the welcome page. Calls the backend's
# /api/auth/dev/* endpoints, which only exist when the backend's matching
# DEV_LOGIN_ENABLED=true is set. Leave UNSET / blank for production builds —
# any other value (e.g. "false", "1") is treated as off.
VITE_DEV_LOGIN_ENABLED=
